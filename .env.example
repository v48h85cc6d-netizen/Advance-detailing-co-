# Public production URL (used for canonical URLs, sitemap, Open Graph). No trailing slash.
VITE_SITE_URL=https://advancedetailingco.com

# ---- Contact form delivery (choose ONE provider) ----
# web3forms  -> free key from https://web3forms.com (emails go to the address you register)
# formspree  -> endpoint like https://formspree.io/f/xxxxxxx
# custom     -> your own backend URL receiving JSON {name,email,message,language} (see server/contact.php)
VITE_CONTACT_PROVIDER=
VITE_CONTACT_ENDPOINT=
VITE_WEB3FORMS_KEY=

# Optional Google Analytics 4 measurement ID (loaded ONLY after the visitor accepts analytics cookies)
VITE_GA_ID=
